# Sound Forge Pro - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# CORE AI SERVICES (Required for AI features)
# ============================================

# Google Gemini AI - Powers all AI agents and features
# Get from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# ============================================
# MUSIC GENERATION ENGINES (Optional)
# ============================================

# Udio - High-fidelity music generation
# Get from: https://www.udio.com/developers
VITE_UDIO_API_KEY=

# Suno - Vocal synthesis and music
# Get from: https://suno.ai/developers
VITE_SUNO_API_KEY=

# MusicGPT - Rapid prototype generation
# Get from: https://musicgpt.ai/api
VITE_MUSICGPT_API_KEY=

# Mureka - Cinematic music generation
# Get from: https://mureka.ai/developers
VITE_MUREKA_API_KEY=

# AIMusic - Experimental hybrid engine
# Get from: https://aimusic.io/api
VITE_AIMUSIC_API_KEY=

# ============================================
# VIDEO & AUDIO SERVICES
# ============================================

# Kling AI - Video generation and lip-sync
# Get from: https://kling.ai/developers
VITE_KLING_ACCESS_KEY=
VITE_KLING_SECRET_KEY=

# Kits.AI - Voice synthesis and stem separation
# Get from: https://kits.ai/developers
VITE_KITS_API_KEY=

# Resemble AI - Voice cloning and deepfake detection
# Get from: https://resemble.ai/
VITE_RESEMBLE_API_KEY=

# ============================================
# FIREBASE CONFIGURATION
# ============================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ============================================
# BLOCKCHAIN & WEB3
# ============================================

# Alchemy - Solana & Polygon RPC
# Get from: https://www.alchemy.com/
VITE_ALCHEMY_API_KEY=
VITE_ALCHEMY_GAS_POLICY_ID=

# ============================================
# PAYMENTS (Stripe)
# ============================================

# Stripe - Payment processing
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# ============================================
# ANALYTICS & INTEGRATIONS
# ============================================

# Chartmetric - Music analytics
# Get from: https://chartmetric.com/
VITE_CHARTMETRIC_API_KEY=
VITE_CHARTMETRIC_REFRESH_TOKEN=

# Lighthouse - IPFS/Filecoin storage
# Get from: https://lighthouse.storage/
VITE_LIGHTHOUSE_API_KEY=

# PushLap - Affiliate tracking
# Get from: https://pushlap.com/
VITE_PUSHLAP_API_KEY=

# ============================================
# WEBHOOKS
# ============================================

VITE_WEBHOOK_URL=

# ============================================
# SERVER CONFIGURATION (for backend)
# ============================================

# RapidAPI - Various API integrations
RAPIDAPI_KEY=

# Google Cloud Storage
GCS_BUCKET=

# Port configuration
PORT=3001
